# ---------------------------------------------------------------
# NeverTwice configuration. Copy this file to `.env` and fill it in.
# ---------------------------------------------------------------

# --- Hindsight (agent memory) -----------------------------------
# Hindsight Cloud: create an API key at https://ui.hindsight.vectorize.io
# (promo code MEMHACK99 adds $50 credit in Billing).
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# Self-hosted Hindsight instead? Use:
# HINDSIGHT_BASE_URL=http://localhost:8888
# HINDSIGHT_API_KEY=

# Memory bank that holds your team's incident history.
HINDSIGHT_BANK_ID=basketbolt-oncall

# --- LLM (any OpenAI-compatible endpoint) -----------------------
# Groq is fast and has a free tier: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Used automatically when the main model is rate-limited or failing.
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# low | medium | high (gpt-oss models). Leave empty for other models.
LLM_REASONING_EFFORT=low

# --- Server -----------------------------------------------------
HOST=127.0.0.1
PORT=8000
